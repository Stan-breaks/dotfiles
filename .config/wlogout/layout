{
    "label" : "lock",
    "action" : "swaylock",
    "text" : "Lock",
    "keybind" : "l"
}

{
    "label" : "logout",
    "action" : "~/.config/scripts/quitWms.sh",
    "text" : "Logout",
    "keybind" : "e"
}

{
    "label" : "suspend",
    "action" : "swaylock -f && loginctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}

{
    "label" : "shutdown",
    "action" : "loginctl poweroff",
    "text" : "Shutdown now",
    "keybind" : "s"
}

{
    "label" : "hibernate",
    "action" : "loginctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}

{
    "label" : "reboot",
    "action" : "loginctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
